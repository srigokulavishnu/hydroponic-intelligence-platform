{
    "model_name": "Nutrient XGBoost Stage-Aware Baseline",
    "model_type": "XGBClassifier",
    "task": "Binary classification",
    "target": "condition_label",
    "classes": {
        "0": "NON_OPTIMAL",
        "1": "OPTIMAL"
    },
    "features": [
        "ph",
        "ec",
        "temperature",
        "humidity",
        "light",
        "growth_stage_encoded"
    ],
    "growth_stage_feature": "growth_stage_encoded",
    "growth_stage_mapping": {
        "EARLY": 0,
        "MIDDLE": 1,
        "LATE": 2
    },
    "label_type": "rule_derived_baseline",
    "stage_rules": {
        "EARLY": {
            "ph_low": 5.8,
            "ph_high": 6.5,
            "ec_low": 0.9,
            "ec_high": 1.3
        },
        "MIDDLE": {
            "ph_low": 5.8,
            "ph_high": 6.5,
            "ec_low": 1.2,
            "ec_high": 1.6
        },
        "LATE": {
            "ph_low": 5.8,
            "ph_high": 6.5,
            "ec_low": 1.5,
            "ec_high": 2.0
        }
    },
    "training_samples": 96768,
    "testing_samples": 24192,
    "hyperparameters": {
        "n_estimators": 300,
        "max_depth": 5,
        "learning_rate": 0.05,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "objective": "binary:logistic",
        "eval_metric": "logloss",
        "random_state": 42
    }
}